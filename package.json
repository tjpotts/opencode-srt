{
  "name": "opencode-srt",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that runs shell commands inside Anthropic Sandbox Runtime",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81"
  },
  "peerDependencies": {
    "@opencode/plugin": "*"
  },
  "devDependencies": {
    "@opencode/plugin": "latest",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
