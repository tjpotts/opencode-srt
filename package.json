{
  "name": "opencode-srt",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin that runs shell commands inside Anthropic Sandbox Runtime",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs && esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --loader:.md=text --outfile=dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "git+https://github.com/tjpotts/sandbox-runtime.git#a4663ea4d2530142aea3cfe427094dabf6df0219"
  },
  "peerDependencies": {
    "@opencode/plugin": "*",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "latest",
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
